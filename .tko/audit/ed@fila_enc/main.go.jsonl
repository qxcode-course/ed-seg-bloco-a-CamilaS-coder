{"ts":1783198372,"hash":"918b2cb476bccfb82946c04df73c5b1369ea16bb14a645a8e7f4c369a94323ec","mode":"diff","ops":[{"tag":"replace","a1":23,"a2":24,"text":"func (q *Queue[T]) Dequeue() (T, bool) {\n\tif q.IsEmpaty() {\n\t\tvar zero T\n\t\treturn zero, false\n\t}\n\tvalue := q.head.Value\n\tq.head = q.head.next\n\tq.size--\n\n\tif q.head == nil {\n\t\tq.tail = nil\n\t}\n\treturn value\n}\n"}]}
